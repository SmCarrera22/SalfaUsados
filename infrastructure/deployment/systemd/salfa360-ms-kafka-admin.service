[Unit]
Description=Salfa360 - Microservicio Administrador Kafka
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/salfa360-app/ms-kafka-admin
EnvironmentFile=/etc/salfa360/ms-kafka-admin.env

ExecStart=/usr/bin/java -Xms64m -Xmx256m -jar /home/ec2-user/salfa360-app/ms-kafka-admin/app.jar

Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
